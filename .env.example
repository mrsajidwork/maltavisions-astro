# WordPress origin (no trailing slash)
WORDPRESS_API_URL=https://staging4.maltavisions.com

# Public site URL for canonicals / OG (no trailing slash)
PUBLIC_SITE_URL=https://astro.maltavisions.com

# Optional — required later for content.raw, menus (authenticated), previews
# WORDPRESS_APPLICATION_USER=
# WORDPRESS_APPLICATION_PASSWORD=

# Contact Form 7 form ID on staging
CF7_FORM_ID=66

# Shared secret WordPress sends to /api/revalidate/ (openssl rand -hex 32)
REVALIDATE_SECRET=

# Seconds to cache WordPress REST responses in memory (cleared on revalidate)
WP_CACHE_TTL_SECONDS=300
