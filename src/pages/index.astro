---
import MainLayout from "../layouts/MainLayout.astro";
import ContactForm from "../components/contact/ContactForm.astro";
import { getPageHtmlBySlug } from "../lib/wordpress/pages";

export const prerender = false;

const result = await getPageHtmlBySlug("home");
if (!result) {
  throw new Error("Home page not found in WordPress REST API");
}

// REST renders the CF7 block in preview mode (placeholder). Split so we inject a real form.
const PLACEHOLDER =
  '<p class="ct-note">Contact Form 7 form #66 renders here on the front end.</p>';
const [beforeForm, afterForm = ""] = result.html.split(PLACEHOLDER);
const title = "MaltaVisions";
---

<MainLayout title={title} variant="home" bodyClass="home mv-page" scripts={["site", "contact", "cf7"]}>
  <main id="main">
    <Fragment set:html={beforeForm} />
    {result.html.includes(PLACEHOLDER) && <ContactForm />}
    <Fragment set:html={afterForm} />
  </main>
</MainLayout>
